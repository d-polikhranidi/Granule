{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ has a column %@ already." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ has a column %2$@ already."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В %@ уже есть столбец %@."
          }
        }
      }
    },
    "%@ is an %@ column: it can't be updated." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ is an %2$@ column: it can't be updated."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — столбец %@: его нельзя обновить."
          }
        }
      }
    },
    "%@ is an %@ column: its values are computed, not inserted." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ is an %2$@ column: its values are computed, not inserted."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — столбец %@: его значения вычисляются, а не вставляются."
          }
        }
      }
    },
    "%@ is in the table's key: it can't be updated." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ входит в ключ таблицы: его нельзя обновить."
          }
        }
      }
    },
    "A parameter is {name:Type}: this one has no type." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Параметр пишется как {name:Type}: у этого нет типа."
          }
        }
      }
    },
